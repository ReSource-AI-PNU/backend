APP_ENV=local
CORS_ORIGINS=["http://localhost:3000"]

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_MAPS_KEY=
AZURE_STORAGE_CONNECTION_STRING=
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/resource_ai

# 수동 Foundry 연결 확인 (FOUNDRY_KEY는 로컬 .env에만 입력)
OPENAI_ENDPOINT=https://resource-ai-busan.services.ai.azure.com/openai/v1
CHAT_DEPLOYMENT=gpt-4.1-mini
FOUNDRY_KEY=

# 플랫폼(track-d)
PLATFORM_SERVICE_KEY=
PLATFORM_DEMO=false
PLATFORM_STAGE_ENDPOINTS={}
PLATFORM_STAGE_TOKEN=
PLATFORM_A2A_PEERS={}
PLATFORM_ADAPTER_TIMEOUT=15
PLATFORM_ROAD_MATRIX_URL=
PLATFORM_ROAD_MATRIX_TOKEN=

# 설계안 v3 (app/v3). V3_LLM은 rule(규칙 정책, 모델 미연결) | foundry | anthropic
# FastAPI(app.main)와 로컬 서버(python -m app.v3.devserver)가 같은 값을 읽는다
V3_LLM=rule
FOUNDRY_ENDPOINT=
FOUNDRY_DEPLOYMENT=
FOUNDRY_API_KEY=
OLLAMA_BASE_URL=
# V3_LLM=anthropic일 때. 키는 값으로 주거나 키만 담은 파일의 경로로 준다(둘 중 하나). 여기에 적지 않는다
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_FILE=
# 비우면 claude-sonnet-5-5
ANTHROPIC_MODEL=
# true면 ollama를 고른 업체도(OLLAMA_BASE_URL이 없을 때) anthropic 모델이 답한다. 화면에는 둘 다 나온다
# (로컬 서버는 1일 때만 켠다)
V3_LLM_ALL_VENDORS=false
V3_VENDOR_AGENTS={}
# true면 시연 되돌리기(POST /api/v3/demo/reset)를 누구나 부른다. 기본은 관리자 조직(org_admin)만
V3_DEMO_OPEN=false
# 요청한 조직을 정하는 방법: header(기본, 시연 전용: X-Org-Id를 믿는다) | token(조직별 서비스 토큰)
# header 모드는 시연 전용이며 공개 주소에 그대로 두면 조직 경계가 지켜지지 않는다
V3_AUTH=header
# token 모드의 조직별 토큰. JSON 글 한 줄: {"org_hanbit": "토큰", "org_saegil": ["새 토큰", "옛 토큰"]}
# 토큰은 16자 이상, 조직마다 다르게. 요청은 Authorization: Bearer <토큰>으로 보낸다(X-Org-Id는 무시)
# 값은 Key Vault에서 주입하고 여기에 적지 않는다
V3_ORG_TOKENS=
# 위 JSON을 담은 파일의 경로(비밀을 파일로 둘 때). 있으면 V3_ORG_TOKENS보다 먼저 읽는다
V3_ORG_TOKENS_FILE=
# 브라우저에서 부를 수 있게 더 허용할 출처. 쉼표로 나눈다(http(s)://호스트[:포트]). FastAPI는 CORS_ORIGINS에 더한다
V3_CORS_ORIGINS=
# 도로 거리 제공자: kakao | azure | none. 비우면 AZURE_MAPS_KEY가 있을 때 Azure Maps를 쓴다
# 제공자가 없거나 호출이 실패하면 직선 거리 × 우회 계수(가정값)로 계산하고 가정값이라고 남긴다
V3_DISTANCE=
# 카카오모빌리티 자동차 길찾기의 REST API 키(V3_DISTANCE=kakao). 여기에 적지 않는다
KAKAO_REST_API_KEY=
# 탐지 모델(Azure ML 관리형 온라인 엔드포인트). 비어 있으면 사진·영상 업로드는 미연결로 답한다
V3_DETECTOR_ENDPOINT=
V3_DETECTOR_API_KEY=
V3_DETECTOR_DEPLOYMENT=
# 업체 측 에이전트 서비스 (배포: app.v3.vendor_service, 로컬: python -m app.v3.vendor_devserver)
# VENDOR_SERVICE_KEY는 회사 측 서버와 업체 측 서버에 같은 값을 준다(Authorization: Bearer)
# 회사 측 서버에는 V3_VENDOR_AGENTS={"org_namhae": "http://127.0.0.1:8032"}처럼 주소를 준다
# 로컬 서버는 --store로 두 프로세스가 같은 저장 파일을 보게 한다(docs/v3/RUNTIME.md 5장)
VENDOR_ORG_ID=
VENDOR_SERVICE_KEY=
# 판단 도구 MCP 서버 (app.v3.mcp_server)
MCP_SERVICE_KEY=
# v3 Azure 연결부. 비워 두면 그 연결은 꺼지고 로컬 경로로 돈다(테스트와 로컬 개발의 기본).
# AZURE_MAPS_KEY, AZURE_SEARCH_ENDPOINT, AZURE_SEARCH_API_KEY는 위의 것을 쓴다. 키는 여기에 적지 않는다
APPLICATIONINSIGHTS_CONNECTION_STRING=
# 문서 추출(Document Intelligence). 비우면 UTF-8 글 파일만 읽는다(extraction "text_only")
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_API_KEY=
# 업로드 문서의 지시문 주입 검사(Content Safety Prompt Shields). 비우면 shieldUnavailable로 표시한다
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_API_KEY=
AZURE_SEARCH_INDEX=rsai-evidence
# 벡터 차원은 임베딩 모델과 같아야 한다: bge-m3 1024, text-embedding-3-small 1536
AZURE_SEARCH_VECTOR_DIMENSIONS=1024
# 임베딩: ollama | foundry | 비움(벡터 없음). 색인(scripts/v3/index_evidence.py)과 질의가 같은 값을 써야 한다
# 배포(infra/vm/deploy-vm.sh)는 foundry + text-embedding-3-small(1536차원)을 쓴다
V3_EMBEDDINGS=
OLLAMA_EMBED_MODEL=bge-m3
FOUNDRY_EMBEDDING_DEPLOYMENT=
# 아래 값은 프로세스 환경 변수로만 읽는다(.env 파일에서 읽지 않는다)
# Microsoft Agent Framework: chat | agent | 비움(urllib로 직접 호출)
V3_AGENT_FRAMEWORK=
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=
FOUNDRY_COMPANY_AGENT_VERSION=
FOUNDRY_VENDOR_AGENT_VERSION=
# 국가법령정보센터 Open API 인증값 (scripts/v3/ingest_laws.py)
LAW_OC=
# 공공데이터포털 인증키 (scripts/v3/fetch_reference_prices.py: 가격조사 참고 시세). 여기에 적지 않는다
DATA_GO_KR_SERVICE_KEY=
