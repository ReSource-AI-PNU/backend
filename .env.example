APP_ENV=local
CORS_ORIGINS=["http://localhost:3000"]

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_MAPS_KEY=
AZURE_STORAGE_CONNECTION_STRING=
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/resource_ai
PLATFORM_SERVICE_KEY=
PLATFORM_DEMO=false
# A/B/C endpoints: classify, feasibility, regulation, cost-carbon, proposal, dispatch.
# See docs/integration-contracts.md. Secrets stay in local env/secret store.
PLATFORM_STAGE_ENDPOINTS={}
PLATFORM_STAGE_TOKEN=
PLATFORM_A2A_PEERS={}
PLATFORM_ADAPTER_TIMEOUT=15
# Optional normalized matrix provider; Azure Maps is used when this is empty and AZURE_MAPS_KEY is set.
PLATFORM_ROAD_MATRIX_URL=
PLATFORM_ROAD_MATRIX_TOKEN=
