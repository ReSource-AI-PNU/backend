    {
      "id": "kc_purge_abs",
      "item": "폐플라스틱",
      "condition": "퍼지 덩어리에 검은 줄무늬가 섞여 있을 때",
      "judgment": "ABS 혼입으로 보고 매각 대신 열분해로 보낸다",
      "rationale": "PP 매입처 입고 검사에서 ABS 혼입으로 반송된 사례 5건.",
      "step": "feasibility",
