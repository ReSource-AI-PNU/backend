    {
      "id": "kc_rain_pp",
      "item": "폐플라스틱",
      "condition": "비 온 다음 날, 야외에 둔 PP 베일",
      "judgment": "수분이 5% 넘는 것으로 보고 한 등급 낮춰 매입한다",
      "rationale": "수거 기사 경험. 지난 3개월 매입 기록 12건 중 10건이 수분 감량 정산이었다.",
      "step": "feasibility",
      "author": "박기사",
      "orgName": "(주)녹산리사이클",
